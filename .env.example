# LLM & Embedding Models (Models are config, not code)
# Options: 'mock' (default for zero-key local evaluation), 'gemini', 'openai_compat'
LLM_PROVIDER=mock
GEMINI_API_KEY=
PRIMARY_LLM_MODEL=gemini-3.5-flash
FALLBACK_LLM_MODEL=gemini-3.1-pro-preview
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

# Security & API
API_KEY=docintel-test-api-key-2026-secure-token
MAX_UPLOAD_MB=200

# Database (PostgreSQL 16 + pgvector)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=docintel
POSTGRES_USER=docintel_user
POSTGRES_PASSWORD=docintel_password_change_me

# Redis 7 (BullMQ & caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_change_me

# OCR & Processing
OCR_LANG=eng
WORKER_INTERNAL_URL=http://worker:8001
API_INTERNAL_URL=http://api:4000
DATA_UPLOADS_DIR=/data/uploads
